msgid "plugins.generic.rdlSolrSearch.displayName"
msgstr "Det Kgl. Biblioteks Solr-søgning"

msgid "plugins.generic.rdlSolrSearch.description"
msgstr "Bruger en selvstændig Solr-server til søgning i publicerede monografier."

msgid "plugins.generic.rdlSolrSearch.settings.status"
msgstr "Forbindelsesstatus"

msgid "plugins.generic.rdlSolrSearch.settings.status.ok"
msgstr "Forbundet til Solr {$version}. Kernen \"{$core}\" indeholder {$numDocs} dokumenter."

msgid "plugins.generic.rdlSolrSearch.settings.status.failed"
msgstr "Kunne ikke bruge Solr-kernen \"{$core}\": {$error}"

msgid "plugins.generic.rdlSolrSearch.settings.status.description"
msgstr "Status kontrolleres med de gemte indstillinger, hver gang denne formular åbnes."

msgid "plugins.generic.rdlSolrSearch.settings.connection"
msgstr "Solr-forbindelse"

msgid "plugins.generic.rdlSolrSearch.settings.solrUrl"
msgstr "Solr-URL"

msgid "plugins.generic.rdlSolrSearch.settings.solrUrl.description"
msgstr "Solrs basis-URL uden kernenavn, f.eks. http://127.0.0.1:8983/solr"

msgid "plugins.generic.rdlSolrSearch.settings.solrUrl.invalid"
msgstr "Angiv en http- eller https-URL uden brugernavn, adgangskode, forespørgselsstreng eller fragment."

msgid "plugins.generic.rdlSolrSearch.settings.solrCore"
msgstr "Kernenavn"

msgid "plugins.generic.rdlSolrSearch.settings.solrCore.invalid"
msgstr "Kernenavnet må kun indeholde bogstaver, tal, bindestreger og understregninger."

msgid "plugins.generic.rdlSolrSearch.settings.solrTimeout"
msgstr "Timeout (sekunder)"

msgid "plugins.generic.rdlSolrSearch.settings.solrTimeout.invalid"
msgstr "Timeout skal være et helt tal mellem 1 og 120."

msgid "plugins.generic.rdlSolrSearch.facet.press"
msgstr "Forlag"

msgid "plugins.generic.rdlSolrSearch.facet.series"
msgstr "Serie"

msgid "plugins.generic.rdlSolrSearch.facet.year"
msgstr "Udgivelsesår"

msgid "plugins.generic.rdlSolrSearch.facets.title"
msgstr "Afgræns resultater"

msgid "plugins.generic.rdlSolrSearch.facets.active"
msgstr "Valgte filtre"

msgid "plugins.generic.rdlSolrSearch.facets.remove"
msgstr "Fjern filter: {$filter}"

msgid "plugins.generic.rdlSolrSearch.facets.count"
msgstr "{$count} titler"

msgid "plugins.generic.rdlSolrSearch.snippet.fulltext"
msgstr "I bogen"

msgid "plugins.generic.rdlSolrSearch.snippet.metadata"
msgstr "I beskrivelsen"

msgid "plugins.generic.rdlSolrSearch.suggest.label"
msgstr "Forslag"
