<?xml version="1.0" encoding="UTF-8" ?>
<!--
  RDLSolrSearch: Solr 9 configuration for the OMP core.

  Kept deliberately small. Text extraction from PDFs happens in OMP (PHP),
  so Solr Cell / the extraction module is not used.

  Deploy changes with solr/deploy.sh; do not edit the copy in the Solr home.
-->
<config>
  <luceneMatchVersion>9.11</luceneMatchVersion>

  <dataDir>${solr.data.dir:}</dataDir>
  <directoryFactory name="DirectoryFactory" class="${solr.directoryFactory:solr.NRTCachingDirectoryFactory}"/>
  <codecFactory class="solr.SchemaCodecFactory"/>

  <!-- Use schema.xml as-is; never let Solr change the schema on its own. -->
  <schemaFactory class="ClassicIndexSchemaFactory"/>

  <indexConfig>
    <lockType>${solr.lock.type:native}</lockType>
  </indexConfig>

  <updateHandler class="solr.DirectUpdateHandler2">
    <updateLog>
      <str name="dir">${solr.ulog.dir:}</str>
    </updateLog>
    <!-- Hard commit for durability; does not make changes visible. -->
    <autoCommit>
      <maxTime>${solr.autoCommit.maxTime:15000}</maxTime>
      <openSearcher>false</openSearcher>
    </autoCommit>
    <!-- Changes become searchable within a few seconds even if the plugin does not commit. -->
    <autoSoftCommit>
      <maxTime>${solr.autoSoftCommit.maxTime:5000}</maxTime>
    </autoSoftCommit>
  </updateHandler>

  <query>
    <maxBooleanClauses>${solr.max.booleanClauses:1024}</maxBooleanClauses>
    <filterCache class="solr.CaffeineCache" size="512" initialSize="512" autowarmCount="0"/>
    <queryResultCache class="solr.CaffeineCache" size="512" initialSize="512" autowarmCount="0"/>
    <documentCache class="solr.CaffeineCache" size="512" initialSize="512" autowarmCount="0"/>
    <enableLazyFieldLoading>true</enableLazyFieldLoading>
    <queryResultWindowSize>20</queryResultWindowSize>
    <queryResultMaxDocsCached>200</queryResultMaxDocsCached>
    <useColdSearcher>false</useColdSearcher>
  </query>

  <requestDispatcher>
    <httpCaching never304="true"/>
  </requestDispatcher>

  <!-- Search used by the plugin. The plugin sends q, qf (localized fields) and filters (fq). -->
  <requestHandler name="/search" class="solr.SearchHandler">
    <lst name="defaults">
      <str name="echoParams">none</str>
      <int name="rows">10</int>
      <!-- All words must match, like OMP's own search. -->
      <str name="q.op">AND</str>
      <str name="qf">title_txt authors</str>
    </lst>
    <lst name="invariants">
      <str name="defType">edismax</str>
      <!-- Analyze the whole query per field: each language applies its own
           stopwords, and words may match in different fields. -->
      <str name="sow">false</str>
      <!-- Users cannot query arbitrary fields with "field:value"; only qf is searched. -->
      <str name="uf">-*</str>
      <str name="fl">id,submission_id,press_id,score</str>
    </lst>
  </requestHandler>

  <!-- Generic handler for administration and debugging. -->
  <requestHandler name="/select" class="solr.SearchHandler">
    <lst name="defaults">
      <str name="echoParams">explicit</str>
      <int name="rows">10</int>
      <str name="df">id</str>
    </lst>
  </requestHandler>

  <requestHandler name="/admin/ping" class="solr.PingRequestHandler">
    <lst name="invariants">
      <str name="q">*:*</str>
      <str name="rows">0</str>
    </lst>
  </requestHandler>

  <queryResponseWriter name="json" class="solr.JSONResponseWriter">
    <str name="content-type">application/json; charset=UTF-8</str>
  </queryResponseWriter>
</config>
